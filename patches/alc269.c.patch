+static void alc269_fixup_vaio_eapd_5db(struct hda_codec *codec,
+                                  const struct hda_fixup *fix, int action)
+{
+        u32 caps;
+        if (action != HDA_FIXUP_ACT_PRE_PROBE)
+                return;
+        static hda_nid_t nids[] = { 0x14, 0x21 };
+        int i;
+        for (i = 0; i < 2; i++) {
+                caps = query_amp_caps(codec, nids[i], HDA_OUTPUT);
+                if (caps) {
+                        caps &= ~AC_AMPCAP_OFFSET;
+                        caps |= (0x14 << AC_AMPCAP_OFFSET_SHIFT); /* GORILLA: Balanced 0x14 offset override */
+                        snd_hda_override_amp_caps(codec, nids[i], HDA_OUTPUT, caps);
+                }
+        }
+        codec_info(codec, "ALC269: VAIO EAPD (+5.5dB balanced offset) unleashed!\n");
+}
