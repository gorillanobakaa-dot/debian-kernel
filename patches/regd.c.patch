 static void ath_force_no_ir_chan(struct ieee80211_channel *ch)
 {
-	ch->flags |= IEEE80211_CHAN_NO_IR;
+	/* GORILLA UNLEASHED: never force NO_IR at the ath9k layer. This is the
+	 * "other half" of the deregulation — the cfg80211 core strip (reg.c)
+	 * is undone here in stock ath9k, which re-stamps NO_IR on ch12/13 and
+	 * DFS. We complete the strip so channels stay transmit-capable in ANY
+	 * regdomain (Japan ch14, DFS/indoor 5 GHz, etc.). Rationale + why:
+	 * see docs/regd.c.md + YOUR_KERNEL_EXPLAINED.md. */
+	ch->flags |= 0 /* was: IEEE80211_CHAN_NO_IR */;
 }
 
